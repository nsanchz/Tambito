<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><c:out value="${tituloPagina}"/> - <c:out value="${sessionScope.nombreEmpresa}" default="BodegaControl"/></title>
    <meta name="context-path" content="${pageContext.request.contextPath}">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/estilos.css">
    <style>
        /* Paleta unificada con el login (granate) y microinteracciones del layout compartido
           por TODAS las vistas autenticadas — cambiar acá impacta toda la app de una vez. */
        :root { --acento: #C00000; --acento-suave: rgba(192,0,0,0.16); }
        @keyframes fadeSlideIn { from { opacity: 0; transform: translateY(-4px); } to { opacity: 1; transform: translateY(0); } }
        .anim-entrada { animation: fadeSlideIn .4s ease both; }
        .nav-link {
            border-left: 3px solid transparent;
            transition: background-color .15s ease, border-color .15s ease, color .15s ease;
        }
        .nav-link:hover { background-color: rgba(255,255,255,0.08); }
        .nav-activo { background-color: var(--acento-suave); border-left-color: var(--acento); font-weight: 500; color: #fff; }
        .avatar-iniciales {
            width: 28px; height: 28px; border-radius: 9999px; background: var(--acento); color: #fff;
            display: flex; align-items: center; justify-content: center; font-size: 0.7rem; font-weight: 700;
            flex-shrink: 0;
        }
        .btn-primario {
            background-color: var(--acento); color: #fff; transition: background-color .15s ease, transform .1s ease;
        }
        .btn-primario:hover { background-color: #a30000; }
        .btn-primario:active { transform: scale(0.97); }
        /* Spinner reutilizable para botones "procesando..." (ver iniciarEnvioConCarga en pie.jspf) */
        .spinner-inline {
            display: inline-block; width: 14px; height: 14px; border: 2px solid rgba(255,255,255,0.4);
            border-top-color: #fff; border-radius: 50%; animation: girar .6s linear infinite; margin-right: 6px;
        }
        @keyframes girar { to { transform: rotate(360deg); } }

        /* Botón "ojito" animado de los campos de contraseña (ver alternarVisibilidadPassword
           en pie.jspf): en vez de alternar type=password/text de golpe, un velo del mismo
           color que el campo se retira/cubre con una animación, dando la sensación de que el
           texto se revela de izquierda a derecha y se oculta de derecha a izquierda. */
        .contenedor-password { position: relative; }
        .btn-ojo {
            position: absolute; right: 6px; top: 50%; transform: translateY(-50%);
            width: 28px; height: 28px; display: flex; align-items: center; justify-content: center;
            border-radius: 9999px; color: #64748b; cursor: pointer; background: transparent; border: none; padding: 0;
            transition: background-color .15s ease, transform .15s ease;
        }
        .btn-ojo:hover { background: rgba(0,0,0,0.06); }
        .btn-ojo:active { transform: translateY(-50%) scale(0.88); }
        .btn-ojo svg { width: 18px; height: 18px; }
        .btn-ojo .icono-ojo-cerrado { display: none; }
        .contenedor-password.mostrando-password .icono-ojo-abierto { display: none; }
        .contenedor-password.mostrando-password .icono-ojo-cerrado { display: block; }
        .velo-password {
            position: absolute; inset: 0; pointer-events: none; border-radius: inherit;
            transform: scaleX(1); transform-origin: right center;
            transition: transform .45s cubic-bezier(.65,0,.35,1);
        }
        .contenedor-password.mostrando-password .velo-password { transform: scaleX(0); }
        @keyframes particulaDesintegrar {
            0% { transform: translate(0,0) scale(1); opacity: .9; }
            100% { transform: translate(var(--dx), var(--dy)) scale(0); opacity: 0; }
        }
        .particula-desintegrar {
            position: absolute; width: 4px; height: 4px; border-radius: 1px; pointer-events: none;
            animation: particulaDesintegrar .55s ease-out forwards;
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-900 antialiased">

<aside class="fixed left-0 top-0 h-screen w-64 bg-slate-900 text-white flex flex-col justify-between z-40">
    <div class="flex flex-col">
        <div class="h-14 px-4 flex items-center bg-black/20 anim-entrada">
            <img src="${pageContext.request.contextPath}/imagen?tipo=logo" alt="Logo"
                 class="h-9 w-auto max-w-[180px] object-contain" onerror="this.style.display='none'">
        </div>
        <nav class="px-2 py-3 flex flex-col gap-1">
            <a href="${pageContext.request.contextPath}/panel-de-control"
               class="nav-link flex items-center gap-2 px-3 py-2 rounded-lg text-sm ${moduloActivo == 'panel-de-control' ? 'nav-activo' : ''}">Panel de control</a>
            <a href="${pageContext.request.contextPath}/pos"
               class="nav-link flex items-center gap-2 px-3 py-2 rounded-lg text-sm ${moduloActivo == 'pos' ? 'nav-activo' : ''}">Punto de Venta (POS)</a>
            <a href="${pageContext.request.contextPath}/turno-caja"
               class="nav-link flex items-center gap-2 px-3 py-2 rounded-lg text-sm ${moduloActivo == 'turno-caja' ? 'nav-activo' : ''}">Turno de Caja</a>
            <a href="${pageContext.request.contextPath}/ventas"
               class="nav-link flex items-center gap-2 px-3 py-2 rounded-lg text-sm ${moduloActivo == 'ventas' ? 'nav-activo' : ''}">Ventas</a>
            <a href="${pageContext.request.contextPath}/productos"
               class="nav-link flex items-center gap-2 px-3 py-2 rounded-lg text-sm ${moduloActivo == 'productos' ? 'nav-activo' : ''}">Productos</a>
            <a href="${pageContext.request.contextPath}/inventario"
               class="nav-link flex items-center gap-2 px-3 py-2 rounded-lg text-sm ${moduloActivo == 'inventario' ? 'nav-activo' : ''}">Inventario</a>
            <a href="${pageContext.request.contextPath}/proveedores"
               class="nav-link flex items-center gap-2 px-3 py-2 rounded-lg text-sm ${moduloActivo == 'proveedores' ? 'nav-activo' : ''}">Proveedores</a>
            <a href="${pageContext.request.contextPath}/ordenes-compra"
               class="nav-link flex items-center gap-2 px-3 py-2 rounded-lg text-sm ${moduloActivo == 'ordenes-compra' ? 'nav-activo' : ''}">Órdenes de compra</a>
            <a href="${pageContext.request.contextPath}/categorias"
               class="nav-link flex items-center gap-2 px-3 py-2 rounded-lg text-sm ${moduloActivo == 'categorias' ? 'nav-activo' : ''}">Categorías</a>
            <a href="${pageContext.request.contextPath}/clientes"
               class="nav-link flex items-center gap-2 px-3 py-2 rounded-lg text-sm ${moduloActivo == 'clientes' ? 'nav-activo' : ''}">Clientes</a>
            <c:if test="${sessionScope.usuarioRol == 'ADMINISTRADOR'}">
                <a href="${pageContext.request.contextPath}/usuarios"
                   class="nav-link flex items-center gap-2 px-3 py-2 rounded-lg text-sm ${moduloActivo == 'usuarios' ? 'nav-activo' : ''}">Usuarios</a>
                <a href="${pageContext.request.contextPath}/reportes"
                   class="nav-link flex items-center gap-2 px-3 py-2 rounded-lg text-sm ${moduloActivo == 'reportes' ? 'nav-activo' : ''}">Reportes</a>
                <a href="${pageContext.request.contextPath}/auditoria"
                   class="nav-link flex items-center gap-2 px-3 py-2 rounded-lg text-sm ${moduloActivo == 'auditoria' ? 'nav-activo' : ''}">Auditoría</a>
                <a href="${pageContext.request.contextPath}/respaldos"
                   class="nav-link flex items-center gap-2 px-3 py-2 rounded-lg text-sm ${moduloActivo == 'respaldos' ? 'nav-activo' : ''}">Respaldos</a>
                <a href="${pageContext.request.contextPath}/configuracion"
                   class="nav-link flex items-center gap-2 px-3 py-2 rounded-lg text-sm ${moduloActivo == 'configuracion' ? 'nav-activo' : ''}">Configuración</a>
            </c:if>
        </nav>
    </div>
</aside>

<div class="pl-64">
    <header class="fixed top-0 left-64 right-0 h-14 bg-white shadow-sm z-30 flex items-center justify-between px-6">
        <h1 class="text-sm font-medium text-slate-500 anim-entrada"><c:out value="${tituloPagina}"/></h1>
        <div class="flex items-center gap-4">
            <div class="flex items-center gap-2">
                <span class="avatar-iniciales">${fn:toUpperCase(fn:substring(sessionScope.usuarioNombre, 0, 1))}</span>
                <span class="text-sm font-medium"><c:out value="${sessionScope.usuarioNombre}"/></span>
            </div>
            <a href="${pageContext.request.contextPath}/perfil" title="Mi perfil" class="text-slate-500 hover:text-slate-900 transition-colors">Perfil</a>
            <a href="${pageContext.request.contextPath}/logout" title="Cerrar sesión" class="text-red-600 hover:text-red-800 transition-colors">Salir</a>
        </div>
    </header>

    <!-- Widgets flotantes de alertas: stock bajo (/api/alertas-stock) y vencimiento/rotación (/api/alertas-inventario) -->
    <div class="fixed bottom-4 right-4 z-50 flex flex-col gap-2 w-80">
        <div id="contenedor-alertas-inventario" class="flex flex-col gap-2"></div>
        <div id="contenedor-alertas-stock" class="flex flex-col gap-2"></div>
    </div>

    <main class="pt-14 px-6 py-6 min-h-screen">
