<%@ page pageEncoding="UTF-8" %>
    </main>
</div>

<script>
    (function () {
        var CLAVE_IGNORADOS = 'bodega_alertas_stock_ignoradas';
        var contenedor = document.getElementById('contenedor-alertas-stock');
        if (!contenedor) {
            return;
        }

        function leerIgnorados() {
            try {
                return JSON.parse(localStorage.getItem(CLAVE_IGNORADOS)) || {};
            } catch (e) {
                return {};
            }
        }

        function guardarIgnorado(productoId, stockActual) {
            var ignorados = leerIgnorados();
            ignorados[productoId] = stockActual;
            try {
                localStorage.setItem(CLAVE_IGNORADOS, JSON.stringify(ignorados));
            } catch (e) {
                // Almacenamiento no disponible (modo privado); la alerta simplemente reaparecerá.
            }
            renderizarAlertas();
        }

        function fueIgnoradoConEsteStock(alerta) {
            var ignorados = leerIgnorados();
            var stockAlIgnorar = ignorados[alerta.productoId];
            // Reaparece si el stock empeoró desde que se ignoró (bajó aún más).
            return stockAlIgnorar !== undefined && alerta.stockActual >= stockAlIgnorar;
        }

        function crearTarjetaAlerta(alerta) {
            var tarjeta = document.createElement('div');
            tarjeta.className = 'bg-white border border-amber-300 shadow-lg rounded-xl p-4 flex flex-col gap-2 animate-[fadeIn_0.2s]';
            tarjeta.innerHTML =
                '<div class="flex items-start justify-between gap-2">' +
                '  <div class="flex flex-col">' +
                '    <span class="text-sm font-semibold text-slate-900">Stock bajo: ' + alerta.productoNombre + '</span>' +
                '    <span class="text-xs text-slate-500">Quedan ' + alerta.stockActual + ' uds (mínimo ' + alerta.stockMinimo + ')</span>' +
                '    <span class="text-xs text-slate-400">Proveedor: ' + alerta.proveedorNombre + '</span>' +
                '  </div>' +
                '  <span class="text-amber-500 text-lg leading-none animate-pulse">&#9888;</span>' +
                '</div>' +
                '<div class="flex items-center justify-end gap-2 pt-1">' +
                '  <button type="button" data-accion="ignorar" class="text-xs px-3 py-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-600 transition-colors">Ignorar</button>' +
                '  <button type="button" data-accion="pedir" class="text-xs px-3 py-1.5 rounded-lg btn-primario font-medium">Pedir producto</button>' +
                '</div>';

            tarjeta.querySelector('[data-accion="ignorar"]').addEventListener('click', function () {
                guardarIgnorado(alerta.productoId, alerta.stockActual);
            });
            tarjeta.querySelector('[data-accion="pedir"]').addEventListener('click', function () {
                var base = document.querySelector('meta[name="context-path"]').getAttribute('content');
                window.location.href = base + '/ordenes-compra?productoId=' + alerta.productoId;
            });

            return tarjeta;
        }

        var ultimasAlertas = [];

        function renderizarAlertas() {
            contenedor.innerHTML = '';
            var visibles = ultimasAlertas.filter(function (a) { return !fueIgnoradoConEsteStock(a); });
            visibles.slice(0, 5).forEach(function (alerta) {
                contenedor.appendChild(crearTarjetaAlerta(alerta));
            });
        }

        function consultarAlertas() {
            var base = document.querySelector('meta[name="context-path"]').getAttribute('content');
            fetch(base + '/api/alertas-stock')
                .then(function (r) { return r.ok ? r.json() : []; })
                .then(function (alertas) {
                    ultimasAlertas = alertas || [];
                    renderizarAlertas();
                })
                .catch(function () { /* si falla, simplemente no se muestran alertas nuevas */ });
        }

        consultarAlertas();
        setInterval(consultarAlertas, 60000);
    })();

    (function () {
        var CLAVE_IGNORADOS = 'bodega_alertas_inventario_ignoradas';
        var contenedor = document.getElementById('contenedor-alertas-inventario');
        if (!contenedor) {
            return;
        }

        function leerIgnorados() {
            try {
                return JSON.parse(localStorage.getItem(CLAVE_IGNORADOS)) || {};
            } catch (e) {
                return {};
            }
        }

        function cerrarAlerta(clave, valorSnapshot) {
            var ignorados = leerIgnorados();
            ignorados[clave] = valorSnapshot;
            try {
                localStorage.setItem(CLAVE_IGNORADOS, JSON.stringify(ignorados));
            } catch (e) {
                // Almacenamiento no disponible (modo privado); la alerta simplemente reaparecerá.
            }
            renderizar(ultimosDatos);
        }

        function fueCerradaConEsteValor(clave, valorActual) {
            var ignorados = leerIgnorados();
            return ignorados[clave] !== undefined && ignorados[clave] === valorActual;
        }

        function crearTarjeta(titulo, subtitulo, colorBorde, clave, valorSnapshot) {
            var tarjeta = document.createElement('div');
            tarjeta.className = 'bg-white border ' + colorBorde + ' shadow-lg rounded-xl p-4 flex flex-col gap-1 relative';
            tarjeta.innerHTML =
                '<button type="button" data-accion="cerrar" title="Cerrar alerta" ' +
                'class="absolute top-2 right-2 text-slate-400 hover:text-slate-700 text-xs leading-none">&#10005;</button>' +
                '<span class="text-sm font-semibold text-slate-900 pr-4">' + titulo + '</span>' +
                '<span class="text-xs text-slate-500">' + subtitulo + '</span>';
            tarjeta.querySelector('[data-accion="cerrar"]').addEventListener('click', function () {
                cerrarAlerta(clave, valorSnapshot);
            });
            return tarjeta;
        }

        var ultimosDatos = {};

        function renderizar(datos) {
            ultimosDatos = datos || {};
            contenedor.innerHTML = '';
            (datos.porVencer || []).forEach(function (l) {
                var clave = 'venc-' + l.loteId;
                if (fueCerradaConEsteValor(clave, l.cantidadActual)) {
                    return;
                }
                contenedor.appendChild(crearTarjeta(
                    'Por vencer: ' + l.productoNombre,
                    'Lote ' + l.numeroLote + ' vence el ' + l.fechaVencimiento + ' (' + l.cantidadActual + ' uds)',
                    'border-red-300', clave, l.cantidadActual));
            });
            (datos.bajaRotacion || []).forEach(function (p) {
                var clave = 'rot-' + p.productoId;
                if (fueCerradaConEsteValor(clave, p.stockActual)) {
                    return;
                }
                contenedor.appendChild(crearTarjeta(
                    'Baja rotación: ' + p.productoNombre,
                    'Sin ventas recientes · Stock actual: ' + p.stockActual + ' uds',
                    'border-slate-300', clave, p.stockActual));
            });
        }

        function consultarAlertasInventario() {
            var base = document.querySelector('meta[name="context-path"]').getAttribute('content');
            fetch(base + '/api/alertas-inventario')
                .then(function (r) { return r.ok ? r.json() : {}; })
                .then(renderizar)
                .catch(function () { /* si falla, simplemente no se muestran alertas nuevas */ });
        }

        consultarAlertasInventario();
        setInterval(consultarAlertasInventario, 60000);
    })();

    /**
     * Helper compartido por TODA la app: deshabilita un botón y le muestra un spinner +
     * texto de "procesando" mientras se envía un formulario, en vez de dejar al usuario sin
     * ningún feedback hasta que la página recargue. Uso típico en el atributo del form:
     *   <form onsubmit="return iniciarEnvioConCarga(this, 'btn-guardar', 'Guardando...')">
     * (el botón de submit necesita id="btn-guardar" o el que se le pase). Siempre retorna
     * true para que el submit continúe con normalidad.
     */
    function iniciarEnvioConCarga(form, idBoton, textoCarga) {
        var boton = document.getElementById(idBoton);
        if (!boton || boton.disabled) {
            return true;
        }
        boton.dataset.textoOriginal = boton.innerHTML;
        boton.disabled = true;
        boton.classList.add('opacity-80', 'cursor-wait');
        boton.innerHTML = '<span class="spinner-inline"></span>' + textoCarga;
        return true;
    }

    /**
     * Menú de acciones (⋮) reutilizable en CUALQUIER tabla de la app (nació en
     * usuarios/lista.jsp, ahora es compartido). Cada botón "Más acciones" debe ir
     * inmediatamente seguido de su <div class="menu-acciones hidden fixed z-50 ...">
     * con los ítems del menú dentro. Se posiciona con `fixed` calculado desde el botón,
     * así no lo corta el scroll horizontal de la tabla ni el borde inferior de la tarjeta.
     */
    function alternarMenuAcciones(boton) {
        var menu = boton.nextElementSibling;
        var estabaAbierto = !menu.classList.contains('hidden');
        cerrarTodosLosMenus();
        if (estabaAbierto) return;

        var rectBoton = boton.getBoundingClientRect();
        menu.classList.remove('hidden');
        var rectMenu = menu.getBoundingClientRect();

        var arriba = rectBoton.bottom + rectMenu.height > window.innerHeight - 8;
        menu.style.top = (arriba ? rectBoton.top - rectMenu.height - 4 : rectBoton.bottom + 4) + 'px';

        var izquierda = rectBoton.right - rectMenu.width;
        if (izquierda < 8) izquierda = 8;
        menu.style.left = izquierda + 'px';
    }

    function cerrarTodosLosMenus() {
        document.querySelectorAll('.menu-acciones').forEach(function (m) { m.classList.add('hidden'); });
    }

    document.addEventListener('click', function (e) {
        if (!e.target.closest('.menu-acciones') && e.target.closest('button')?.getAttribute('title') !== 'Más acciones') {
            cerrarTodosLosMenus();
        }
    });
    window.addEventListener('scroll', cerrarTodosLosMenus, true);
    window.addEventListener('resize', cerrarTodosLosMenus);

    /**
     * Botón "ojito" de un campo de contraseña (ver .btn-ojo/.velo-password en cabecera.jspf).
     * Al revelar: el input pasa a type=text de inmediato (invisible, porque el velo todavía
     * lo cubre) y luego el velo se retira hacia la derecha, dando la sensación de que el
     * texto se revela de izquierda a derecha. Al ocultar: el velo vuelve a cubrir de derecha
     * a izquierda y recién cuando termina (ya tapado) el input regresa a type=password; de
     * paso se lanzan unas partículas que se desvanecen, como un pequeño "chasquido".
     */
    function alternarVisibilidadPassword(idCampo, boton) {
        var input = document.getElementById(idCampo);
        var contenedor = input.closest('.contenedor-password');
        var velo = contenedor.querySelector('.velo-password');
        var revelando = input.type === 'password';

        if (revelando) {
            input.type = 'text';
            contenedor.classList.add('mostrando-password');
        } else {
            contenedor.classList.remove('mostrando-password');
            lanzarParticulasDesintegracion(contenedor, input);
            setTimeout(function () { input.type = 'password'; }, 420);
        }
    }

    /** Calca el color de fondo real del input en su velo, para que combine exacto sea un formulario claro u oscuro. */
    function inicializarOjosPassword() {
        document.querySelectorAll('.contenedor-password').forEach(function (contenedor) {
            var input = contenedor.querySelector('.input-password');
            var velo = contenedor.querySelector('.velo-password');
            if (!input || !velo) return;
            var estilo = getComputedStyle(input);
            velo.style.background = estilo.backgroundColor;
            velo.style.borderRadius = estilo.borderRadius;
        });
    }
    inicializarOjosPassword();

    function lanzarParticulasDesintegracion(contenedor, input) {
        var rect = input.getBoundingClientRect();
        var rectContenedor = contenedor.getBoundingClientRect();
        for (var i = 0; i < 12; i++) {
            var particula = document.createElement('span');
            particula.className = 'particula-desintegrar';
            particula.style.left = (rect.left - rectContenedor.left + Math.random() * rect.width) + 'px';
            particula.style.top = (rect.top - rectContenedor.top + Math.random() * rect.height) + 'px';
            particula.style.background = '#94a3b8';
            particula.style.setProperty('--dx', ((Math.random() - 0.5) * 60) + 'px');
            particula.style.setProperty('--dy', (-15 - Math.random() * 35) + 'px');
            particula.style.animationDelay = (Math.random() * 0.1) + 's';
            contenedor.appendChild(particula);
            (function (el) { setTimeout(function () { el.remove(); }, 700); })(particula);
        }
    }
</script>
</body>
</html>
